{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.project.sourcePaths": [
    "src/main/java",
    "examples/recommendation-system/src",
    "examples/recommendation-system/mr",
    "examples/ta4j/src/main/java",
    "examples/ta4j/mr",
    "examples/ta4j/generated/renko/junit-tests"
  ],
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-17",
      "path": "/opt/homebrew/Cellar/openjdk@17/17.0.15/libexec/openjdk.jdk/Contents/Home"
    },
    {
      "name": "JavaSE-25",
      "path": "/Library/Java/JavaVirtualMachines/microsoft-25.jdk/Contents/Home",
      "default": true
    }
  ],
  "java.debug.settings.onBuildFailureProceed": true
}
