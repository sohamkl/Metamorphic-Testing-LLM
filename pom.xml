<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>nz.ac.auckland.mt</groupId>
    <artifactId>mt-testing-llm</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>MT Testing LLM Prototype</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <freemarker.version>2.3.34</freemarker.version>
        <snakeyaml.version>2.2</snakeyaml.version>
        <pitest.version>1.25.5</pitest.version>
        <pitest.junit5.plugin.version>1.2.3</pitest.junit5.plugin.version>
        <randoop.version>4.3.4</randoop.version>
        <classgraph.version>4.8.184</classgraph.version>
        <instancio.version>5.6.0</instancio.version>
        <javaparser.version>3.28.2</javaparser.version>
        <jsoup.version>1.23.2-SNAPSHOT</jsoup.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
            <version>${freemarker.version}</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>${snakeyaml.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.classgraph</groupId>
            <artifactId>classgraph</artifactId>
            <version>${classgraph.version}</version>
        </dependency>
        <dependency>
            <groupId>org.instancio</groupId>
            <artifactId>instancio-core</artifactId>
            <version>${instancio.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-core</artifactId>
            <version>${javaparser.version}</version>
        </dependency>
        <!--
            Randoop (feedback-directed test generation) used in-process as an object factory for the
            RANDOOP input-generation mode. Distributed as a single all-in-one jar with no Maven
            Central artifact, so it is vendored under lib/ and referenced with system scope. To
            switch to a local-repo install instead: drop the systemPath, run
            `mvn install:install-file -Dfile=lib/randoop-all-4.3.4.jar -DgroupId=org.randoop
            -DartifactId=randoop-all -Dversion=4.3.4 -Dpackaging=jar`, and remove the lib/ jar.
        -->
        <dependency>
            <groupId>org.randoop</groupId>
            <artifactId>randoop-all</artifactId>
            <version>${randoop.version}</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/randoop-all-${randoop.version}.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>examples/joda-money/src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-example-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>examples/dijkstra-shortest-path/src</source>
                                <source>examples/dijkstra-shortest-path/mr</source>
                                <source>examples/matrix-rank/src</source>
                                <source>examples/matrix-rank/mr</source>
                                <source>examples/pricing/src</source>
                                <source>examples/pricing/mr</source>
                                <source>examples/recommendation-system/src</source>
                                <source>examples/recommendation-system/mr</source>
                                <source>examples/joda-money/src/main/java/org/joda/money</source>
                                <source>examples/joda-money/src/main/java/org/joda/convert</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-generated-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>examples/dijkstra-shortest-path/generated/junit-tests</source>
                                <source>examples/dijkstra-shortest-path/generated/junit-support</source>
                                <source>examples/matrix-rank/generated/junit-tests</source>
                                <source>examples/matrix-rank/generated/junit-support</source>
                                <source>examples/pricing/generated/junit-tests</source>
                                <source>examples/pricing/generated/junit-support</source>
                                <source>examples/recommendation-system/generated/junit-tests</source>
                                <source>examples/recommendation-system/generated/junit-support</source>
                                <source>examples/joda-money/generated/junit-tests</source>
                                <source>examples/joda-money/generated/junit-support</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <excludes>
                        <exclude>**/module-info.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>jsoup</id>
            <dependencies>
                <dependency>
                    <groupId>org.jsoup</groupId>
                    <artifactId>jsoup</artifactId>
                    <version>${jsoup.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-jsoup-example-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>examples/jsoup/mt-testing/src/main/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-jsoup-test-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>examples/jsoup/mt-testing/src/test/java</source>
                                        <source>examples/jsoup/mt-testing/generated/node-filter-clone/junit-tests</source>
                                        <source>examples/jsoup/mt-testing/generated/node-filter-clone/junit-support</source>
                                        <source>examples/jsoup/mt-testing/generated/node-filter-stop-suffix/junit-tests</source>
                                        <source>examples/jsoup/mt-testing/generated/cleaner-idempotence/junit-tests</source>
                                        <source>examples/jsoup/mt-testing/generated/cleaner-idempotence/junit-support</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>ta4j</id>
            <properties>
                <maven.compiler.release>25</maven.compiler.release>
                <ta4j.version>0.23.1-SNAPSHOT</ta4j.version>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.ta4j</groupId>
                    <artifactId>ta4j-core</artifactId>
                    <version>${ta4j.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-ta4j-example-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>examples/ta4j/src/main/java</source>
                                        <source>examples/ta4j/mr</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-ta4j-generated-tests</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>examples/ta4j/generated/renko/junit-tests</source>
                                        <source>examples/ta4j/generated/renko-scaled-stuttering/junit-tests</source>
                                        <source>examples/ta4j/generated/slope-change-swing/junit-tests</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>pitest</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-ta4j-sut-for-pitest</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/examples/ta4j/ta4j-core/target/classes</directory>
                                            <filtering>false</filtering>
                                            <includes>
                                                <include>org/ta4j/core/analysis/elliott/swing/SlopeChangeSwingDetector.class</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest.junit5.plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <!-- <param>DijkstraAlgorithm*</param>
                                <param>MatrixRank</param>
                                <param>PricingEngine*</param>
                                <param>RecommendationEngine</param> -->
                                <param>org.ta4j.core.analysis.elliott.swing.SlopeChangeSwingDetector</param>
                            </targetClasses>
                            <targetTests>
                                <param>GeneratedSlopeChangeSwingDetectorMetamorphicPassingTest</param>
                            </targetTests>
                            <excludedTestClasses>
                                <param>*FailingTest</param>
                            </excludedTestClasses>
                            <additionalSources>
                                <param>${project.basedir}/examples/ta4j/ta4j-core/src/main/java</param>
                            </additionalSources>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <mutationThreshold>0</mutationThreshold>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>pitest-jsoup</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-jsoup-sut-for-pitest</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/examples/jsoup/target/classes</directory>
                                            <filtering>false</filtering>
                                            <includes>
                                                <include>org/jsoup/select/NodeTraversor.class</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest.junit5.plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>org.jsoup.select.NodeTraversor</param>
                            </targetClasses>
                            <targetTests>
                                <param>GeneratedNodeTraversorFilterCloneMetamorphicPassingTest</param>
                            </targetTests>
                            <excludedTestClasses>
                                <param>*FailingTest</param>
                            </excludedTestClasses>
                            <additionalSources>
                                <param>${project.basedir}/examples/jsoup/src/main/java</param>
                            </additionalSources>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <reportsDirectory>${project.build.directory}/pit-reports/jsoup-node-traversor</reportsDirectory>
                            <timestampedReports>false</timestampedReports>
                            <mutationThreshold>0</mutationThreshold>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>pitest-jsoup-cleaner</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-jsoup-cleaner-for-pitest</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/examples/jsoup/target/classes</directory>
                                            <filtering>false</filtering>
                                            <includes>
                                                <include>org/jsoup/safety/Cleaner*.class</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest.junit5.plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>org.jsoup.safety.Cleaner*</param>
                            </targetClasses>
                            <targetTests>
                                <param>GeneratedJsoupCleanerIdempotenceMetamorphicPassingTest</param>
                            </targetTests>
                            <excludedTestClasses>
                                <param>*FailingTest</param>
                            </excludedTestClasses>
                            <additionalSources>
                                <param>${project.basedir}/examples/jsoup/src/main/java</param>
                            </additionalSources>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <reportsDirectory>${project.build.directory}/pit-reports/jsoup-cleaner-idempotence</reportsDirectory>
                            <timestampedReports>false</timestampedReports>
                            <mutationThreshold>0</mutationThreshold>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
